# Where the chat server is.
BASE_URL=http://localhost:4000

# From `npm run setup`, or the Bots screen.
SIGNING_SECRET=
WEBHOOK_URL=

# Only needed for answers that arrive late (/slow, /chatty) — those call the
# bot API, which needs a bearer token. Shown once, at creation.
BOT_TOKEN=

# Where the chat server delivers to: your tunnel, NOT localhost.
EVENT_URL=

# This bot listens here.
PORT=3000
